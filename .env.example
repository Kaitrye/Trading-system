# Локальные значения уже заданы в docker-compose.yml и application.yaml.
# Скопируйте этот файл в .env, только если хотите их изменить.
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_PORT=5432
APP_PORT=8080

# Переменные приложения. Нужны, если БД запускается не на localhost:5432.
DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USER=trading
DB_PASSWORD=trading

# Required for the application. Generate a unique Base64 value with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# Optional administrator, created once on startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
