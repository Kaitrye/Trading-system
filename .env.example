# Демонстрационные локальные значения. Docker Compose подхватывает этот файл автоматически.
# Создайте .env только если хотите переопределить отдельные значения.
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_PORT=5432
APP_PORT=8080

# Для запуска приложения без Docker.
DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USER=trading
DB_PASSWORD=trading

# Только для локальной демонстрации: перед публикацией замените все эти значения.
JWT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_EXPIRATION_SECONDS=3600
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345
